index a6ca192..c694416 100644
--- a/src/libretro/CMakeLists.txt
+++ b/src/libretro/CMakeLists.txt
@@ -1,3 +1,6 @@
+# Modified on 2026-11-17 by anyps5-retro-host's swanstation-01-core-build-identity.patch
+# (AnyPS5 Desktop contributors): the AnyPS5 core build identity's header folder.
+
 add_library(swanstation_libretro SHARED
   libretro_audio_stream.cpp
   libretro_audio_stream.h
@@ -11,6 +14,7 @@ add_library(swanstation_libretro SHARED
 )
 
 target_link_libraries(swanstation_libretro PRIVATE core common glad vulkan-loader libretro-common)
+target_include_directories(swanstation_libretro PRIVATE "${CMAKE_BINARY_DIR}/anyps5")
 
 # no lib prefix
 set_target_properties(swanstation_libretro PROPERTIES PREFIX "")
