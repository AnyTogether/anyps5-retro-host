Description: Report the AnyPS5 core build identity as library_version
 anyps5-retro-host's cores/apply-swanstation-patches.sh writes anyps5-core-source.txt
 beside SwanStation's top CMakeLists.txt. With that file, CMake adds the build options
 that change what the core computes (MSB_FIRST) to it, and library_version becomes
 anyps5-1-<SHA-256 of the whole> (anyps5-retro-host docs/netplay.md "Core build
 identity"). Without it the core keeps SwanStation's own library_version.
Author: AnyPS5 Desktop contributors
Forwarded: not-needed
Last-Update: 2026-11-17

diff --git a/CMakeLists.txt b/CMakeLists.txt
index cac0d2f..8848392 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,3 +1,6 @@
+# Modified on 2026-11-17 by anyps5-retro-host's swanstation-01-core-build-identity.patch
+# (AnyPS5 Desktop contributors): the AnyPS5 core build identity, below MSB_FIRST.
+
 cmake_minimum_required(VERSION 3.10)
 project(swanstation C CXX)
 
@@ -162,6 +165,30 @@ if(MSB_FIRST)
   add_definitions("-DMSB_FIRST=1")
 endif()
 
+# AnyPS5 core build identity (anyps5-retro-host docs/netplay.md "Core build identity"). The
+# host's cores/apply-swanstation-patches.sh writes anyps5-core-source.txt beside this file: the
+# SwanStation commit, the date the patches last modified it, and the SHA-256 and name of each
+# patch it applied, in order. The build options that change what the core computes are added to
+# it here, and library_version becomes anyps5-1-<SHA-256 of the whole>, the same for the same
+# emulation on every system. Without that file the core keeps SwanStation's own library_version.
+set(ANYPS5_CORE_IDENTITY "")
+set(ANYPS5_CORE_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/anyps5-core-source.txt")
+if(EXISTS "${ANYPS5_CORE_SOURCE}")
+  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ANYPS5_CORE_SOURCE}")
+  file(READ "${ANYPS5_CORE_SOURCE}" ANYPS5_CORE_MANIFEST)
+  if(MSB_FIRST)
+    string(APPEND ANYPS5_CORE_MANIFEST "option MSB_FIRST=ON\n")
+  else()
+    string(APPEND ANYPS5_CORE_MANIFEST "option MSB_FIRST=OFF\n")
+  endif()
+  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/anyps5-core-manifest.txt" "${ANYPS5_CORE_MANIFEST}")
+  string(SHA256 ANYPS5_CORE_DIGEST "${ANYPS5_CORE_MANIFEST}")
+  set(ANYPS5_CORE_IDENTITY "anyps5-1-${ANYPS5_CORE_DIGEST}")
+  message("AnyPS5 core build identity: ${ANYPS5_CORE_IDENTITY}")
+endif()
+configure_file("${CMAKE_CURRENT_SOURCE_DIR}/src/libretro/anyps5_core_identity.h.in"
+               "${CMAKE_CURRENT_BINARY_DIR}/anyps5/anyps5_core_identity.h" @ONLY)
+
 # Recursively include the source tree.
 enable_testing()
 add_subdirectory(dep)
